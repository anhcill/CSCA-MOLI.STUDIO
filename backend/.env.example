# ====================================
# CSCA Backend — Environment Variables
# Copy file này thành .env và điền giá trị thực
# ⚠️  KHÔNG commit file .env lên git!
# ====================================

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL=postgresql://user:password@host:5432/database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=csca_db

# Database backups (Admin tổng). On Windows, the default is
# %USERPROFILE%\database_backup. Set an explicit path when needed.
# DATABASE_BACKUP_DIR=C:\Users\your-user\database_backup
# Optional separate source database; defaults to DATABASE_URL.
# DATABASE_BACKUP_URL=postgresql://user:password@host:5432/database
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# DATABASE_BACKUP_TIMEZONE=Asia/Ho_Chi_Minh

# ── JWT Auth ──────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_64_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────
PORT=5000
NODE_ENV=development

# CSCA Courses is fail-closed. Apply migrations 052, 053 and 054 in order before
# changing this exact value from false to true on Railway.
CSCA_COURSES_ENABLED=false

# ── Frontend URL (CORS) ───────────────────
# Development:
FRONTEND_URL=http://localhost:3000
# Production (Railway): https://molystudio.online,https://www.molystudio.online

# ── Cloudflare Turnstile ─────────────────
# Production phải cấu hình secret; thiếu secret hoặc TURNSTILE_DISABLED=true
# sẽ fail-closed thay vì cho qua các route đăng ký/đặt lại mật khẩu.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,molystudio.online,www.molystudio.online
# Optional: dùng khi widget được cấu hình action cố định.
TURNSTILE_EXPECTED_ACTION=
# Login-only temporary bypass; set false to require Cloudflare on web login again.
TURNSTILE_LOGIN_DISABLED=true
# Chỉ có hiệu lực ngoài production để dev không cần secret.
TURNSTILE_ALLOW_FAIL_OPEN=true

# ── Google OAuth ──────────────────────────
# Tạo tại: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Facebook OAuth ────────────────────────
# Tạo tại: https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_OAUTH_VERSION=v21.0

# ── Brevo Email (Sendinblue) ─────────────────────────────────────────────────
# Đăng ký: https://app.brevo.com → Settings → SMTP & API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_CRITICAL_API_KEY=your_second_brevo_api_key_here
BREVO_CRITICAL_RESERVE=50
VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_MS=600000
VERIFICATION_EMAIL_RATE_LIMIT_MAX=3
EMAIL_SENDER=notification@example.com
EMAIL_SENDER_NAME=MOLY.STUDIO Notifications
EMAIL_CRITICAL_SENDER=security@example.com
EMAIL_CRITICAL_SENDER_NAME=MOLY.STUDIO Security
EMAIL_MARKETING_SENDER=marketing@example.com
EMAIL_MARKETING_SENDER_NAME=MOLY.STUDIO
# Marketing campaigns use BREVO_CRITICAL_API_KEY and need a list from that account.
BREVO_MARKETING_LIST_ID=
BREVO_DEFAULT_MARKETING_LIST_ID=
BREVO_CRITICAL_MARKETING_LIST_ID=
BREVO_WEBHOOK_SECRET=
EMAIL_REPLY_TO=
EMAIL_UNSUBSCRIBE_SECRET=

# ── Cloudinary (ảnh & tài liệu PDF) ──────
# Đăng ký miễn phí tại: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Cloudflare R2 (PDF tài liệu lớn) ───────
# PDF > MATERIAL_R2_MIN_MB sẽ lưu vào R2 thay vì DB/Cloudinary.
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=moly-materials
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_REGION=auto
MATERIAL_R2_MIN_MB=10

# ── CSCA course video (dedicated private R2 bucket) ──
# Do not reuse the PDF/material bucket credentials in production.
VIDEO_R2_ACCOUNT_ID=your_video_r2_account_id
VIDEO_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
VIDEO_R2_BUCKET=moly-course-videos
VIDEO_R2_ACCESS_KEY_ID=your_video_r2_access_key_id
VIDEO_R2_SECRET_ACCESS_KEY=your_video_r2_secret_access_key

# Public HTTPS origin of the Cloudflare video gateway (no secret/query string).
VIDEO_GATEWAY_BASE_URL=https://video.example.com
# Generate a random value of at least 32 bytes; configure the same secret on Worker.
VIDEO_PLAYBACK_TOKEN_SECRET=replace_with_random_secret_at_least_32_bytes
VIDEO_PLAYBACK_TOKEN_ISSUER=csca-api
VIDEO_PLAYBACK_TOKEN_AUDIENCE=csca-video-gateway
VIDEO_PLAYBACK_TTL_SECONDS=14400
VIDEO_UPLOAD_TTL_SECONDS=900
# Configure this on the Worker deployment too. Never use * with credentials.
VIDEO_ALLOWED_ORIGINS=http://localhost:3000,https://molystudio.online,https://www.molystudio.online

# Course write limits. Public catalog GETs only use the existing global limiter.
COURSE_ENROLL_RATE_LIMIT_WINDOW_MS=900000
COURSE_ENROLL_RATE_LIMIT_MAX=10
COURSE_PROGRESS_RATE_LIMIT_WINDOW_MS=60000
COURSE_PROGRESS_RATE_LIMIT_MAX=180
COURSE_PLAYBACK_RATE_LIMIT_WINDOW_MS=300000
COURSE_PLAYBACK_RATE_LIMIT_MAX=30
COURSE_ADMIN_RATE_LIMIT_WINDOW_MS=900000
COURSE_ADMIN_RATE_LIMIT_MAX=60
COURSE_MEDIA_RATE_LIMIT_WINDOW_MS=900000
COURSE_MEDIA_RATE_LIMIT_MAX=30

# ── Beeknoee AI (OpenAI-compatible proxy) ──
AI_PROVIDER=beeknoee
# Add more keys comma-separated. BEEKNOEE_API_KEY_1, BEEKNOEE_API_KEY_2, ... also work.
BEEKNOEE_API_KEYS=sk-bee-your_key_1,sk-bee-your_key_2,sk-bee-your_key_3,sk-bee-your_key_4,sk-bee-your_key_5,sk-bee-your_key_6
BEEKNOEE_MODEL=gpt-5.4-mini
BEEKNOEE_OCR_MODEL=google/gemini-3.1-flash-lite
BEEKNOEE_IMPORT_MODEL=google/gemini-3.1-flash-lite
BEEKNOEE_IMPORT_FALLBACK_MODEL=google/gemini-3.1-flash-lite
BEEKNOEE_REVIEW_MODEL=google/gemini-3.1-flash-lite
BEEKNOEE_PET_CHAT_MODEL=google/gemini-3.1-flash-lite
MOLI_PET_DAILY_LIMIT=20
MOLI_PET_BURST_LIMIT=6
MOLI_PET_MIN_INTERVAL_MS=3000
MOLI_PET_REPEAT_WINDOW_MS=45000
MOLI_PET_MAX_MESSAGE_LENGTH=600
MOLI_PET_MAX_TOKENS=3000
BEEKNOEE_BASE_URL=https://platform.beeknoee.com/api/v1
BEEKNOEE_TIMEOUT_MS=90000
BEEKNOEE_OCR_TIMEOUT_MS=120000
AI_MAX_CONCURRENT=3
AI_REQUEST_SPACING_MS=300
AI_GLOBAL_BACKOFF_MS=90000
AI_EXAM_ANALYSIS_MAX_TOKENS=6000
AI_CHAT_MAX_TOKENS=2200

# Admin exam AI provider. Used only for OCR/import/review/fix exam in admin.
# If this provider fails, backend falls back to Beeknoee models above.
# Railway cannot call localhost on your PC. Use a public URL, Railway private URL, or a tunnel URL.
ADMIN_EXAM_AI_PROVIDER=9router
ADMIN_EXAM_AI_BASE_URL=
ADMIN_EXAM_AI_API_KEYS=
ADMIN_EXAM_AI_MODEL=ag/gemini-3.1-pro-low
ADMIN_EXAM_AI_OCR_MODEL=ag/gemini-3.1-pro-low
ADMIN_EXAM_AI_IMPORT_MODEL=ag/gemini-3.1-pro-low
ADMIN_EXAM_AI_IMPORT_FALLBACK_MODEL=ag/gemini-3-flash
ADMIN_EXAM_AI_REVIEW_MODEL=ag/claude-sonnet-4-6
ADMIN_EXAM_AI_FIX_MODEL=ag/claude-sonnet-4-6
ADMIN_EXAM_AI_OCR_MODELS=ag/gemini-3.1-pro-low,ag/gemini-3-flash,ag/claude-sonnet-4-6
ADMIN_EXAM_AI_IMPORT_MODELS=ag/gemini-3.1-pro-low,ag/gemini-3-flash,ag/claude-sonnet-4-6
ADMIN_EXAM_AI_REVIEW_MODELS=ag/claude-sonnet-4-6,ag/gemini-3.1-pro-low,ag/gemini-3-flash
ADMIN_EXAM_AI_FIX_MODELS=ag/claude-sonnet-4-6,ag/gemini-3.1-pro-low,ag/gemini-3-flash

# SEO Blog AI uses the same 9router connection. Leave model empty to inherit ADMIN_EXAM_AI_MODEL.
SEO_BLOG_AI_MODEL=
SEO_BLOG_AI_MAX_TOKENS=6000
# Configure at least one image provider, or supply a curated JSON topic library.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
SEO_BLOG_TOPIC_IMAGE_LIBRARY={}

# Moly pet chat uses 9router first, Beeknoee only as fallback.
MOLI_PET_PROVIDER=9router
MOLI_PET_MODEL=ag/gemini-3-flash-agent
MOLI_PET_FALLBACK_PROVIDER=beeknoee
MOLI_PET_FALLBACK_MODEL=google/gemini-3.1-flash-lite
MOLI_PET_TIMEOUT_MS=45000

# ── File Upload ───────────────────────────
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,audio/mpeg,audio/wav

# ── MoMo Payment ─────────────────────────
# Đăng ký sandbox/production: https://business.momo.vn/
# Sandbox: https://sandbox.momo.vn
# ⚠️ Khi lên production: thay ENDPOINT + bật IPN_URL (HTTPS bắt buộc)
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMOTEST
MOMO_ACCESS_KEY=F8BBD362
MOMO_SECRET_KEY=xxxx
MOMO_REDIRECT_URL=https://your-domain.com/checkout/success
MOMO_IPN_URL=https://your-domain.com/api/payments/momo-webhook

# ── VNPay Payment ─────────────────────────
# Đăng ký: https://sandbox.vnpayment.vn/apis
# Production: https://vnpayment.vn
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=TESTVNPAY
VNPAY_HASH_SECRET=xxxx
VNPAY_RETURN_URL=https://your-domain.com/checkout/success

# ── Debug (tuỳ chọn) ──────────────────────
# Bật query logging khi cần debug
# DEBUG_QUERIES=1
