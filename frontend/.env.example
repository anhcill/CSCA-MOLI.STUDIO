// ─── File: frontend/.env.example ──────────────────────────────────────────────────

# ====================================
# CSCA Frontend — Environment Variables
# Copy file này thành .env.local
# ⚠️  KHÔNG commit file .env.local lên git!
# ====================================

# ── Site URL (SEO, sitemap, metadata) ─
NEXT_PUBLIC_SITE_URL=https://moly-studio.io.vn

# ── Backend API URL ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Production:
# NEXT_PUBLIC_API_URL=https://csca-molistudio-production.up.railway.app/api

# ── Socket.io URL (KHÔNG có /api) ────────
# Development:
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Production (Railway):
# NEXT_PUBLIC_SOCKET_URL=https://csca-molistudio-production.up.railway.app

# ── Google Analytics ──────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google OAuth ───────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Facebook OAuth ─────────────────────────
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
